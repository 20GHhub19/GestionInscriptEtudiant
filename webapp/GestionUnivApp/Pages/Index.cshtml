@page
@model IndexModel
@{
    ViewData["Title"] = "Accueil";
}

<div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Systeme de Gestion Universitaire</h1>
    <p class="lead text-muted">Gestion des inscriptions, des cours, des notes et des resultats</p>

    @if (!(User.Identity?.IsAuthenticated ?? false))
    {
        <div class="mt-3">
            <a class="btn btn-primary btn-lg me-2" asp-area="Identity" asp-page="/Account/Register">S'inscrire</a>
            <a class="btn btn-outline-secondary btn-lg" asp-area="Identity" asp-page="/Account/Login">Se connecter</a>
        </div>
    }
    else
    {
        <div class="mt-3">
            @if (User.IsInRole("Etudiant"))
            {
                <a class="btn btn-primary btn-lg me-2" asp-page="/Etudiant/EtudiantDashboard">Acceder a mon dossier</a>
            }
            @if (User.IsInRole("Professeur"))
            {
                <a class="btn btn-success btn-lg me-2" asp-page="/Professeur/ProfDashboard">Acceder a mes cours</a>
            }
            @if (User.IsInRole("Administrateur"))
            {
                <a class="btn btn-warning btn-lg me-2" asp-page="/Administrateur/AdminDashboard">Administration</a>
            }
            @if (!User.IsInRole("Etudiant") && !User.IsInRole("Professeur") && !User.IsInRole("Administrateur"))
            {
                <div class="alert alert-info mt-3 d-inline-block">
                    Votre compte est en attente d'attribution de role. Un administrateur vous assignera un role prochainement.
                </div>
            }
        </div>
    }
</div>

<div class="row text-center g-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="display-6 fw-bold text-primary">@Model.NbEtudiants</h2>
                <p class="text-muted mb-0">Etudiants</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="display-6 fw-bold text-success">@Model.NbProfesseurs</h2>
                <p class="text-muted mb-0">Professeurs</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="display-6 fw-bold text-info">@Model.NbCours</h2>
                <p class="text-muted mb-0">Cours offerts</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="display-6 fw-bold text-warning">@Model.NbProgrammes</h2>
                <p class="text-muted mb-0">Programmes</p>
            </div>
        </div>
    </div>
</div>

<div class="row mt-5 g-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Inscription aux cours</h5>
                <p class="card-text">Les etudiants peuvent s'inscrire a des cours en fonction de leur programme, avec validation automatique des prerequis.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Suivi des notes</h5>
                <p class="card-text">Consultez vos notes par evaluation, votre moyenne ponderee et votre releve de notes complet.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Gestion des programmes</h5>
                <p class="card-text">Les administrateurs gerent les programmes, les affectations de professeurs et les sessions d'examens.</p>
            </div>
        </div>
    </div>
</div>
